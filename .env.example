# Copy this file to .env and fill in your PostgreSQL details (Neon, Supabase, Railway, etc.)
# NEVER commit .env to git — it is in .gitignore.
# On Render/Vercel set these same keys as Environment Variables in the dashboard.

# Neon example:
# DB_HOST=ep-xxx-xxx.us-east-1.aws.neon.tech
# DB_USER=username
# DB_PASSWORD=password
# DB_NAME=batloung_farm
# DB_PORT=5432
# DB_SSL=true

# Supabase example:
# DB_HOST=db.xxx.supabase.co
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=postgres
# DB_PORT=5432
# DB_SSL=true

# Railway example:
# DB_HOST=containers-us-west-1.railway.app
# DB_USER=postgres
# DB_PASSWORD=password
# DB_NAME=railway
# DB_PORT=5432
# DB_SSL=true

# Local PostgreSQL example:
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=batloung_farm
# DB_PORT=5432
# DB_SSL=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=batloung_farm
DB_SSL=false

PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
FRONTEND_URL=http://localhost:3000