# Copy this file to .env and fill in your Aiven MySQL details.
# NEVER commit .env to git — it is in .gitignore.
# On Render/Vercel set these same keys as Environment Variables in the dashboard.

DB_HOST=batloungfarm-mamakakelamakhaba-d586.f.aivencloud.com
DB_PORT=12157
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true
# DB_CA_PATH is optional on Render/Vercel (SSL still works without it).
# For local development, download ca.pem from Aiven and set:
# DB_CA_PATH=./ca.pem

PORT=3000
